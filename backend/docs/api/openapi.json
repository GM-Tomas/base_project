{
  "openapi": "3.0.1",
  "info": {
    "title": "BASE Wealth Management \u0026 Tasks API",
    "description": "REST API construida con Kotlin y Spring Boot 3 para gestión de activos patrimoniales, proyecciones financieras y tareas.",
    "contact": {
      "name": "BASE Engineering Team",
      "email": "dev@base-wealth.internal"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Wealth",
      "description": "Endpoints de resumen patrimonial, proyecciones financieras e histórico"
    },
    {
      "name": "Platforms",
      "description": "Endpoints de plataformas y entidades financieras"
    },
    {
      "name": "Asset classes",
      "description": "Clases de activo sugeridas y en uso por el usuario"
    },
    {
      "name": "Holdings",
      "description": "Endpoints para la gestión de posiciones y activos financieros"
    },
    {
      "name": "Health",
      "description": "Monitoreo del estado y disponibilidad de la API"
    }
  ],
  "paths": {
    "/api/v1/wealth/snapshots": {
      "get": {
        "tags": [
          "Wealth"
        ],
        "summary": "Serie histórica de patrimonio neto, con variación porcentual contra el punto anterior",
        "operationId": "getSnapshots",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SnapshotResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Wealth"
        ],
        "summary": "Captura un snapshot del patrimonio actual, calculado en el servidor",
        "operationId": "createSnapshot",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platforms": {
      "get": {
        "tags": [
          "Platforms"
        ],
        "summary": "Lista todas las plataformas del usuario, incluidas las que no tienen posiciones",
        "operationId": "getAllPlatforms",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlatformResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Platforms"
        ],
        "summary": "Crea una nueva plataforma",
        "operationId": "createPlatform",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePlatformRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/holdings": {
      "get": {
        "tags": [
          "Holdings"
        ],
        "summary": "Lista las posiciones del usuario, opcionalmente filtradas por clase o plataforma",
        "operationId": "getAllHoldings",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "assetClass",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "platform",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HoldingResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Holdings"
        ],
        "summary": "Crea una nueva posición de inversión",
        "operationId": "createHolding",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateHoldingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HoldingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platforms/{name}": {
      "delete": {
        "tags": [
          "Platforms"
        ],
        "summary": "Elimina una plataforma sin posiciones asociadas",
        "operationId": "deletePlatform",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "patch": {
        "tags": [
          "Platforms"
        ],
        "summary": "Renombra o recategoriza una plataforma existente",
        "operationId": "patchPlatform",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchPlatformRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/holdings/{id}": {
      "get": {
        "tags": [
          "Holdings"
        ],
        "summary": "Obtiene el detalle de una posición por su ID",
        "operationId": "getHoldingById",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HoldingResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Holdings"
        ],
        "summary": "Elimina una posición financiera",
        "operationId": "deleteHolding",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "patch": {
        "tags": [
          "Holdings"
        ],
        "summary": "Actualiza parcialmente los datos de una posición existente",
        "operationId": "updateHolding",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateHoldingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HoldingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/wealth/summary": {
      "get": {
        "tags": [
          "Wealth"
        ],
        "summary": "Obtiene el resumen consolidado de patrimonio neto, métricas y distribuciones",
        "operationId": "getSummary",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/WealthSummaryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/wealth/estimate": {
      "get": {
        "tags": [
          "Wealth"
        ],
        "summary": "Calcula la proyección de interés compuesto y el progreso de hitos financieros",
        "operationId": "getEstimate",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "contribution",
            "in": "query",
            "required": true,
            "schema": {
              "maximum": 1000000000,
              "exclusiveMaximum": false,
              "minimum": 0.0,
              "exclusiveMinimum": false,
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "yieldPct",
            "in": "query",
            "required": true,
            "schema": {
              "maximum": 100.0,
              "exclusiveMaximum": false,
              "minimum": 0.0,
              "exclusiveMinimum": false,
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "years",
            "in": "query",
            "required": true,
            "schema": {
              "maximum": 50,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "milestones",
            "in": "query",
            "required": false,
            "schema": {
              "maxItems": 5,
              "minItems": 0,
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            }
          },
          {
            "name": "principal",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Verifica el estado operativo del servicio backend",
        "operationId": "checkHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/asset-classes": {
      "get": {
        "tags": [
          "Asset classes"
        ],
        "summary": "Lista las clases de activo por defecto, en uso, y la unión de ambas",
        "operationId": "getAvailableAssetClasses",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AvailableAssetClassesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SnapshotResponse": {
        "required": [
          "capturedAt",
          "id",
          "totalValueUsd"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "totalValueUsd": {
            "type": "number",
            "format": "double"
          },
          "changePctFromPrevious": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "CreatePlatformRequest": {
        "required": [
          "name",
          "type"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "PlatformResponse": {
        "required": [
          "createdAt",
          "name",
          "type"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateHoldingRequest": {
        "required": [
          "assetClass",
          "name",
          "platform",
          "valueUsd"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "assetClass": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "valueUsd": {
            "minimum": 0.0,
            "exclusiveMinimum": false,
            "type": "number",
            "format": "double"
          }
        }
      },
      "HoldingResponse": {
        "required": [
          "assetClass",
          "createdAt",
          "id",
          "name",
          "platform",
          "updatedAt",
          "valueUsd"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "assetClass": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "valueUsd": {
            "type": "number",
            "format": "double"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PatchPlatformRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "UpdateHoldingRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "assetClass": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "valueUsd": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "AssetClassBreakdown": {
        "required": [
          "assetClass",
          "count",
          "pct",
          "valueUsd"
        ],
        "type": "object",
        "properties": {
          "assetClass": {
            "type": "string"
          },
          "valueUsd": {
            "type": "number",
            "format": "double"
          },
          "pct": {
            "type": "number",
            "format": "double"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "FxRateDTO": {
        "required": [
          "available"
        ],
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "value": {
            "type": "number",
            "format": "double"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "LiquidityDTO": {
        "required": [
          "illiquidPct",
          "liquidAssetClasses",
          "liquidPct"
        ],
        "type": "object",
        "properties": {
          "liquidPct": {
            "type": "number",
            "format": "double"
          },
          "illiquidPct": {
            "type": "number",
            "format": "double"
          },
          "liquidAssetClasses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "NetWorthDTO": {
        "required": [
          "fxRate",
          "usd"
        ],
        "type": "object",
        "properties": {
          "usd": {
            "type": "number",
            "format": "double"
          },
          "ars": {
            "type": "number",
            "format": "double"
          },
          "fxRate": {
            "$ref": "#/components/schemas/FxRateDTO"
          }
        }
      },
      "PlatformBreakdown": {
        "required": [
          "count",
          "name",
          "pct",
          "type",
          "valueUsd"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "valueUsd": {
            "type": "number",
            "format": "double"
          },
          "pct": {
            "type": "number",
            "format": "double"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "WealthSummaryResponse": {
        "required": [
          "byAssetClass",
          "byPlatform",
          "holdingsCount",
          "liquidity",
          "netWorth",
          "ytd"
        ],
        "type": "object",
        "properties": {
          "netWorth": {
            "$ref": "#/components/schemas/NetWorthDTO"
          },
          "holdingsCount": {
            "type": "integer",
            "format": "int32"
          },
          "ytd": {
            "$ref": "#/components/schemas/YtdDTO"
          },
          "liquidity": {
            "$ref": "#/components/schemas/LiquidityDTO"
          },
          "byAssetClass": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetClassBreakdown"
            }
          },
          "byPlatform": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlatformBreakdown"
            }
          }
        }
      },
      "YtdDTO": {
        "required": [
          "basis",
          "growthPct"
        ],
        "type": "object",
        "properties": {
          "basis": {
            "type": "string"
          },
          "growthPct": {
            "type": "number",
            "format": "double"
          },
          "baselineValueUsd": {
            "type": "number",
            "format": "double"
          },
          "baselineAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MilestoneResponse": {
        "required": [
          "amountUsd",
          "status"
        ],
        "type": "object",
        "properties": {
          "amountUsd": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "type": "string"
          },
          "monthsRequired": {
            "type": "integer",
            "format": "int32"
          },
          "targetMonth": {
            "type": "string"
          }
        }
      },
      "ProjectionPointResponse": {
        "required": [
          "futureValueUsd",
          "interestEarnedUsd",
          "totalContributedUsd",
          "year"
        ],
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "futureValueUsd": {
            "type": "number",
            "format": "double"
          },
          "totalContributedUsd": {
            "type": "number",
            "format": "double"
          },
          "interestEarnedUsd": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ProjectionResponse": {
        "required": [
          "annualYieldPct",
          "milestones",
          "monthlyContributionUsd",
          "principalUsd",
          "series",
          "years"
        ],
        "type": "object",
        "properties": {
          "principalUsd": {
            "type": "number",
            "format": "double"
          },
          "monthlyContributionUsd": {
            "type": "number",
            "format": "double"
          },
          "annualYieldPct": {
            "type": "number",
            "format": "double"
          },
          "years": {
            "type": "integer",
            "format": "int32"
          },
          "series": {
            "type": "array",
            "items": {
