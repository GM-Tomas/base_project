#!/bin/sh
# Keeps docs/api/openapi.json in sync with the API on every commit.
# Enabled via: git config core.hooksPath .githooks

if git diff --cached --name-only | grep -q '^src/'; then
  echo "src/ changed — regenerating OpenAPI docs..."
  ./gradlew generateOpenApiDocs -q || {
    echo "OpenAPI doc generation failed — commit aborted." >&2
    exit 1
  }
  git add docs/api/openapi.json
fi
